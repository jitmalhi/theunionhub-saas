# ─────────────────────────────────────────────────────────────
# The Union Hub · .gitignore
# ─────────────────────────────────────────────────────────────

# Secrets — NEVER commit
.env
.env.local
.env.*.local
*.pem
*.key

# Vercel
.vercel/
.vercel.json.bak

# Supabase local
supabase/.branches/
supabase/.temp/
supabase/.env

# Node / package managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp.*

# Build artifacts
dist/
build/
.cache/
.parcel-cache/
.turbo/
.next/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Local-only assets
/private/
/.scratch/
