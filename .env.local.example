# ─────────────────────────────────────────────────────────────
# The Union Hub · environment variables (template)
# Copy to .env.local and fill real values. .env.local is gitignored.
# NEVER commit real keys to this repo.
# ─────────────────────────────────────────────────────────────

# Supabase project URL (public — safe to expose to the browser).
# Prototype value for reference: https://frdvhmzbsmczknqtexvx.supabase.co
SUPABASE_URL=

# Supabase publishable / anon key (public — RLS is the boundary, not secrecy).
# Served to the browser via /api/config or injected by edge middleware.
SUPABASE_ANON_KEY=

# Supabase service-role key (SECRET — server-side only).
# Used in api/ functions for privileged operations. NEVER ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Base apex domain for tenant subdomain resolution in production.
# MUST match the live apex — it OVERRIDES the registry apex in the middleware,
# so a stale value here silently breaks tenant subdomain routing.
# Local dev: use lvh.me (resolves *.lvh.me → 127.0.0.1).
PUBLIC_BASE_DOMAIN=theunionhub.ca
